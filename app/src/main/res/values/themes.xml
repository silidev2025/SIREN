<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the shipped build: light app window, dark navy splash. -->
    <style name="Theme.SIREN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SIREN.Starting" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/Theme.SIREN</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_shield</item>
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
    </style>
</resources>
