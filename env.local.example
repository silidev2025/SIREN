# Release signing for SIREN. Copy this file to env.local (same folder, the repo root)
# and fill in the passwords. env.local is gitignored; this template is the only copy
# that is committed, and it must never hold a real password.
#
# These are the same four keys keystore.properties used, so an existing
# keystore.properties can be pasted in here unchanged.
#
# Before filling this in, read "The release signing key" in CLAUDE.md: check which key
# you hold against the recorded SHA-256 fingerprints, and do not generate a new one.

storeFile=siren-release.jks
storePassword=
keyAlias=siren
keyPassword=
