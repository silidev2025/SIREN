#pragma once

// Copy this file to secrets.h and fill in the values.
// secrets.h is gitignored — never commit real credentials.
//
// EVERY value must stay wrapped in "double quotes". Removing them produces
// a misleading compile error, e.g.
//   'MyNetworkName' was not declared in this scope

#define WIFI_SSID       "YOUR_WIFI_NAME"        // 2.4 GHz only — the ESP32 cannot see 5 GHz
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// Firebase console -> Project settings -> General -> Project ID.
// Must be the same Firebase project the mobile app uses.
#define FIREBASE_PROJECT_ID  "YOUR_FIREBASE_PROJECT_ID"

// Firebase console -> Project settings -> General -> Web API Key
#define FIREBASE_API_KEY     "YOUR_WEB_API_KEY"

// The ESP32 signs in as its own Firebase account and writes alert documents
// directly. Create this user under Authentication -> Users first, or the
// firmware compiles and then fails at runtime with an auth error.
#define ESP32_ACCOUNT_EMAIL     "esp32@siren.local"
#define ESP32_ACCOUNT_PASSWORD  "YOUR_ESP32_ACCOUNT_PASSWORD"

#define NODE_ID  "node-01"

// ---------------------------------------------------------------------------
// SIM800L GSM fallback — optional.
//
// Leave SIM800L_ENABLED at 0 and the firmware behaves exactly as it did before
// the modem existed; none of the values below are read. Set it to 1 only once
// the module is wired AND on its own 3.4-4.4 V supply — see firmware/README.md.
//
// The modem sends SMS only. It does not carry the Firestore write: SIM800L is
// 2G and its TLS stack cannot complete a handshake with Google's endpoints.
// So when WiFi is down the phones get a text, not an in-app alert.
// ---------------------------------------------------------------------------
#define SIM800L_ENABLED  0

// Who gets texted. Comma-separated, E.164 (leading +, country code), max 5.
// These are the people who must know even when the internet is down — the
// adviser and the school's emergency contact, not the whole class.
//   #define SIM_RECIPIENTS  "+639171234567,+639281234567"
#define SIM_RECIPIENTS  ""

// Lowest band that sends a text: "green", "yellow" or "red".
// "green" texts on every detectable tremor and will burn load fast.
#define SIM_MIN_BAND  "yellow"

// Minimum gap between SMS batches, milliseconds. An aftershock sequence can
// fire repeatedly; without this each one costs another round of messages.
#define SIM_SMS_COOLDOWN_MS  120000UL
